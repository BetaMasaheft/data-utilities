      a rml:LogicalTargetMap ;
      rml:template "{/tei:TEI/@xml:id}.ttl" ;
    ] ;    
] ;
rml:predicateObjectMap [
    rml:predicate crm:P102_has_title ;
    rml:objectMap [
        rml:template "https://betamasaheft.eu/{/tei:TEI/@xml:id}/title/{normalize-space(@xml:id)}" ;
        rml:termType rml:IRI ;
    ]
] ;
.

# mappings for tei:div[ancestor::tei:div[@type = 'edition']
<mapping-15> a rml:TriplesMap ;
rml:logicalSource [
    rml:source "input.xml" ;
    rml:iterator "/tei:TEI/tei:text/tei:body/tei:div[@type = 'edition']/tei:div" ;
    rml:referenceFormulation [ a rml:XPathReferenceFormulation ;
       rml:namespace [ a rml:Namespace ;
         rml:namespacePrefix "tei" ;
         rml:namespaceURL "http://www.tei-c.org/ns/1.0" ;
       ];    
     ] ;
] ;
rml:subjectMap [
    rml:template "https://betamasaheft.eu/{/tei:TEI/@xml:id}" ;
    rml:LogicalTargetMap [
      a rml:LogicalTargetMap ;
      rml:template "{/tei:TEI/@xml:id}.ttl" ;
    ] ;    
] ;
rml:predicateObjectMap [
    rml:predicate dcterms:hasPart ;
    rml:objectMap [
        rml:template "https://betamasaheft.eu/{/tei:TEI/@xml:id}/{@type}/{@xml:id}" ;
        rml:termType rml:IRI ;
    ]
] ;
.

